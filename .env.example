# NVIDIA NIM API Settings
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Two NVIDIA NIM Model Options
NVIDIA_PRIMARY_MODEL=mistralai/mistral-large-2-instruct
NVIDIA_SECONDARY_MODEL=mistralai/codestral-22b-instruct-v0.1

# Active Model ("primary", "secondary", "flan_t5", or "auto")
DEFAULT_MODEL_CHOICE=auto

# Local FLAN-T5 Model Path & Fallback Settings
TRAINED_SQL_MODEL_PATHS=training/artifacts/flan_t5_sql_lora/final
ENABLE_LOCAL_FLAN_FALLBACK=true
ENABLE_RULE_BASED_FALLBACK=true

# Few-Shot Prompting Configuration
FEW_SHOT_MAX_EXAMPLES=3
ENABLE_DYNAMIC_FEW_SHOT=true
